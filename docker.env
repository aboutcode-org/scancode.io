POSTGRES_DB=scancodeio
POSTGRES_USER=scancodeio
POSTGRES_PASSWORD=scancodeio
POSTGRES_INITDB_ARGS=--encoding=UTF-8 --lc-collate=en_US.UTF-8 --lc-ctype=en_US.UTF-8

SCANCODEIO_DB_HOST=db
SCANCODEIO_RQ_REDIS_HOST=redis
SCANCODEIO_ASYNC=True
SCANCODEIO_WORKSPACE_LOCATION=/var/scancodeio/workspace/
GRIMOIRELAB_METRICS_EXECUTABLE=/opt/healthycode/.venv/bin/grimoirelab-metrics

# ---------------------------------------------------------------------------
# Nix pipeline cache
# ---------------------------------------------------------------------------
# The Nix pipeline runs Docker inside Docker. Two containers are involved:
#
#   - `worker`  creates the nixpkgs git checkout and per-scan worktrees here.
#   - `dind`    uses those worktrees as a bind mount for the Nix build container.
#
# Both containers must see the exact same directory, so this path lives on
# the shared `workspace` volume, which is mounted at `/var/scancodeio/workspace/`
# in both.
#
# If you change this to a container-local path (like `~/.cache/scancode-nix`),
# `dind` will not find the worktrees, the Nix build will fail.
SCANCODEIO_NIXPKGS_CACHE_DIR=/var/scancodeio/workspace/.cache/scancode-nix

# ---------------------------------------------------------------------------
# Docker-in-Docker (DinD) Support
# ---------------------------------------------------------------------------
# Certain pipelines require access to a Docker daemon. This is provided by the
# opt-in `dind` service, which is not started by default. To enable it:
#
#   1. Uncomment the three variables below.
#   2. Start the stack with the required profile (e.g., "dind"):
#          docker compose --profile dind up
#
# The dind daemon listens on port 2376 with mutual TLS. Client certificates
# are generated on first start and shared with the web/worker services
# through the `dind_certs` volume. See docker-compose.yml for details.
#
# Uncomment these three variables when you enable the dind service.
# DOCKER_HOST=tcp://dind:2376
# DOCKER_TLS_VERIFY=1
# DOCKER_CERT_PATH=/certs/client

# Optional: GitHub token for the scan_nix_package pipeline's commit
# verification. Raises the API limit from 60 to 5,000 requests/hour.
# SCANCODEIO_GITHUB_TOKEN="ghp_xxx"
